doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")    
    title 本日の様子 修正

  body
  
    .container.mt-4
      form(action=`/note/edit/${record.id}` method="post")
        .card.mt-4(style="max-width:300px")
          .card-header.bg-success.text-white.py-2
            h5.mb-0 本日の様子

              

          textarea.form-control(
            name="note"
            rows="8"
          )= record.note

        button.btn.btn-success.mt-3(
          type="submit"
        ) 保存

