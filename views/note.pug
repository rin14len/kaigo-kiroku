doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    title 本日の様子

  body(style="background-color:#f8faf8;")
    include partials/navbar.pug
    .container(style="margin-top:90px;")
      h1.fs-1.fw-bold.text-success.mb-4 本日の様子 管理画面
      
      if errorMessage
        .alert.bg-danger.text-white.fw-bold
          = errorMessage
      
      if message
        .alert.bg-success.text-white.fw-bold
          = message

      form(action="/note" method="post")
        table.table.table-success.table-striped.table-bordered
          thead
            tr
              th.bg-success.text-white
                input#selectAll(type="checkbox")
              th.bg-success.text-white 利用者名
              th.bg-success.text-white 実施状況
              th.bg-success.text-white 修正

          tbody
            each user in users
              - const record = noteRecords.find(record => record.careUserId === user.id)
              tr
                td
                  input.user-check(type="checkbox" name="userIds" value=user.id)
                td= user.name
                td
                  if record
                    |#{record.note}
                  else
                    | 未入力
                td
                  if record
                    a.btn.btn-success.btn-sm.fw-bold(href=`/note/edit/${record.id}`) 修正
                  else
                    | -
                  
            
        .card.mt-4(style="max-width:300px")
          .card-header.bg-success.text-white.py-2
            h6.mb-0 本日の様子

          .card-body.py-2
            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="exercise"
                id="exercise"
              )
              label.form-check-label(for="exercise") 体操
            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="coloring"
                id="coloring"
              )
              label.form-check-label(for="coloring") 塗り絵

            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="karaoke"
                id="karaoke"
              )
              label.form-check-label(for="karaoke") カラオケ
            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="recreation"
                id="recreation"
              )
              label.form-check-label(for="recreation") レクリエーション

            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="rest"
                id="rest"
              )
              label.form-check-label(for="rest") 休息
            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="relaxing"
                id="relaxing"
              )
              label.form-check-label(for="relaxing") 穏やか
            .form-check
              input.form-check-input(
                type="checkbox"
                name="activities"
                value="tv"
                id="tv"
              )
              label.form-check-label(for="tv") テレビ

    
            .form-check.mb-1
              label.form-label 本日の様子
              input.form-control(
                type="text"
                name="memo"
                )

        div.mt-3
          button.btn.btn-success.px-4.fw-bold(type="submit") 登録

      script.
        const selectAll = document.getElementById('selectAll');
        const checks = document.querySelectorAll('.user-check');

        selectAll.addEventListener('change', () => {
          checks.forEach(check => {
            check.checked = selectAll.checked;
          });
        });
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")